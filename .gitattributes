# Default: normalize text files to LF on commit, OS-native on checkout.
* text=auto eol=lf

# Windows shell scripts must keep CRLF or cmd.exe gets unhappy.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Source files explicitly tagged as text.
*.py        text diff=python
*.cpp       text diff=cpp
*.h         text diff=cpp
*.hpp       text diff=cpp
*.cu        text
*.md        text
*.txt       text
*.json      text
*.yml       text
*.yaml      text

# Binary assets — never EOL-normalize, never diff.
*.png       binary
*.ico       binary
*.exe       binary
*.lib       binary
*.zip       binary
*.pdf       binary

# GitHub linguist hints — count this repo as Python, not C++ from
# the bundled VanitySearch source.
VanitySearch-Warthog/** linguist-vendored
